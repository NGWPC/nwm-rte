#
# TODO have remote vs local be parameterized in config file rather than requiring switching comment blocks here.
#


ARG NGEN_BASE_IMAGE="ghcr.io/ngwpc/ngen:latest"
FROM $NGEN_BASE_IMAGE AS ngen_rte_base

### Additional user args, these have to be after the FROM
ARG REPO_TAG__FCST_MGR
ARG REPO_TAG__MSW_MGR
ARG REPO_TAG__CAL_MGR
ARG REPO_TAG__REGION_MGR
ARG REPO_TAG__VERF_MGR
ARG REPO_TAG__EVAL_MGR
ARG REPO_TAG__DATA_ASSIM_ENGINE
ARG REPO_TAG__NGEN_FORCING

### Static args
ARG PYTHON_ENV="/ngen-app/ngen-python/bin"
ARG GITHUB_ORG_URL="https://github.com/NGWPC"
ARG GITHUBUSERCONTENT_ORG_URL="https://raw.githubusercontent.com/NGWPC"
ARG REPO_NAME__FCST_MGR="nwm-fcst-mgr"
ARG REPO_NAME__CAL_MGR="nwm-cal-mgr"
ARG REPO_NAME__MSW_MGR="nwm-msw-mgr"
ARG REPO_NAME__REGION_MGR="nwm-region-mgr"
ARG REPO_NAME__VERF_MGR="nwm-verf"
ARG REPO_NAME__EVAL_MGR="nwm-eval-mgr"
ARG REPO_NAME__DATA_ASSIM_ENGINE="data-assimilation-engine"
ARG REPO_NAME__NGEN_FORCING="ngen-forcing"

ARG MSWM_MODULE_PARAMETER_FILES="/ngen-app/${REPO_NAME__MSW_MGR}/src/mswm/module_parameter_files"

### For Python 3.10 base image (ngen ghcr ngen:latest as of 10/28/25)
# ARG PYTHON_VERSION_STR="python3.10"
### For Python 3.11 base image (ngen development as of 10/28/25)
ARG PYTHON_VERSION_STR="python3.11"

ENV PIP_NO_CACHE_DIR=1
ENV OMPI_ALLOW_RUN_AS_ROOT=1
ENV OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1

COPY nwm-rte/add_git_info.py .

### Create directory for git info JSON files
RUN mkdir -p /ngen-app/git-info

### Activate the venv
ENV PATH="${PYTHON_ENV}:${PATH}"
RUN python -m pip install --upgrade pip


##############################
##### Forecast Manager

## From GitHub
RUN python -m pip install "${GITHUB_ORG_URL}/${REPO_NAME__FCST_MGR}/archive/${REPO_TAG__FCST_MGR}.tar.gz"
RUN python add_git_info.py --remote_repo_name "${REPO_NAME__FCST_MGR}" --remote_branch "${REPO_TAG__FCST_MGR}" --output_dir "/ngen-app/git-info"

## From local
# COPY "${REPO_NAME__FCST_MGR}/" "/tmp/${REPO_NAME__FCST_MGR}/"
# RUN python -m pip install "/tmp/${REPO_NAME__FCST_MGR}" && \
#     python add_git_info.py --local_repo_path "/tmp/${REPO_NAME__FCST_MGR}" --output_dir "/ngen-app/git-info" && \
#     rm -rf "/tmp/${REPO_NAME__FCST_MGR}"


##############################
##### Model Setup Workflow Manager

## From GitHub
RUN python -m pip install "${GITHUB_ORG_URL}/${REPO_NAME__MSW_MGR}/archive/${REPO_TAG__MSW_MGR}.tar.gz"
RUN python add_git_info.py --remote_repo_name "${REPO_NAME__MSW_MGR}" --remote_branch "${REPO_TAG__MSW_MGR}" --output_dir "/ngen-app/git-info"
RUN mkdir -p `dirname ${MSWM_MODULE_PARAMETER_FILES}`

## From local
# COPY "${REPO_NAME__MSW_MGR}/" "/tmp/${REPO_NAME__MSW_MGR}/"
# RUN python -m pip install "/tmp/${REPO_NAME__MSW_MGR}" && \
#     python add_git_info.py --local_repo_path "/tmp/${REPO_NAME__MSW_MGR}" --output_dir "/ngen-app/git-info" && \
#     rm -rf "/tmp/${REPO_NAME__MSW_MGR}"

## Either way, do the symlink to module_parameter_files. TODO improve this
RUN mkdir -p "`dirname ${MSWM_MODULE_PARAMETER_FILES}`" && ln -s "/ngen-app/ngen-python/lib/${PYTHON_VERSION_STR}/site-packages/mswm/module_parameter_files" "${MSWM_MODULE_PARAMETER_FILES}"


##############################
#### Calibration Manager (TODO have executable py scripts come included with python -m pip install)

## From GitHub
RUN python -m pip install "${GITHUB_ORG_URL}/${REPO_NAME__CAL_MGR}/archive/${REPO_TAG__CAL_MGR}.tar.gz#subdirectory=python/calib"
RUN python -m pip install "${GITHUB_ORG_URL}/${REPO_NAME__CAL_MGR}/archive/${REPO_TAG__CAL_MGR}.tar.gz#subdirectory=python/config"
ADD "${GITHUBUSERCONTENT_ORG_URL}/${REPO_NAME__CAL_MGR}/${REPO_TAG__CAL_MGR}/python/calibration.py" "/ngen-app/bin/"
ADD "${GITHUBUSERCONTENT_ORG_URL}/${REPO_NAME__CAL_MGR}/${REPO_TAG__CAL_MGR}/python/validation.py" "/ngen-app/bin/"
ADD "${GITHUBUSERCONTENT_ORG_URL}/${REPO_NAME__CAL_MGR}/${REPO_TAG__CAL_MGR}/python/validation_iteration.py" "/ngen-app/bin/"
RUN python add_git_info.py --remote_repo_name "${REPO_NAME__CAL_MGR}" --remote_branch "${REPO_TAG__CAL_MGR}" --output_dir "/ngen-app/git-info"

## From local
# COPY "${REPO_NAME__CAL_MGR}/" "/tmp/${REPO_NAME__CAL_MGR}/"
# RUN \
#     python -m pip install "/tmp/${REPO_NAME__CAL_MGR}/python/calib" && \
#     python -m pip install "/tmp/${REPO_NAME__CAL_MGR}/python/config" && \
#     python add_git_info.py --local_repo_path "/tmp/${REPO_NAME__CAL_MGR}" --output_dir "/ngen-app/git-info" && \
#     rm -rf "/tmp/${REPO_NAME__CAL_MGR}/"
# ADD "${REPO_NAME__CAL_MGR}/python/calibration.py" "/ngen-app/bin/"
# ADD "${REPO_NAME__CAL_MGR}/python/validation.py" "/ngen-app/bin/"
# ADD "${REPO_NAME__CAL_MGR}/python/validation_iteration.py" "/ngen-app/bin/"


##############################
#### Region Manager

## From GitHub
RUN python -m pip install "nwm_region_mgr[parreg] @ git+${GITHUB_ORG_URL}/${REPO_NAME__REGION_MGR}@${REPO_TAG__REGION_MGR}"
RUN python add_git_info.py --remote_repo_name "${REPO_NAME__REGION_MGR}" --remote_branch "${REPO_TAG__REGION_MGR}" --output_dir "/ngen-app/git-info"

## From local
# COPY "${REPO_NAME__REGION_MGR}/" "/tmp/${REPO_NAME__REGION_MGR}/"
# RUN python -m pip install "/tmp/${REPO_NAME__REGION_MGR}[parreg]" && \
#     python add_git_info.py --local_repo_path "/tmp/${REPO_NAME__REGION_MGR}" --output_dir "/ngen-app/git-info" && \
#     rm -rf "/tmp/${REPO_NAME__REGION_MGR}/"

##############################
#### Data Assimilation Engine

## From GitHub
RUN python -m pip install "data_assimilation_engine @ git+${GITHUB_ORG_URL}/${REPO_NAME__DATA_ASSIM_ENGINE}@${REPO_TAG__DATA_ASSIM_ENGINE}"
RUN python add_git_info.py --remote_repo_name "${REPO_NAME__DATA_ASSIM_ENGINE}" --remote_branch "${REPO_TAG__DATA_ASSIM_ENGINE}" --output_dir "/ngen-app/git-info"
# RUN python -m pip install "git+${GITHUB_ORG_URL}/${REPO_NAME__DATA_ASSIM_ENGINE}@${REPO_TAG__DATA_ASSIM_ENGINE}"


##############################
##### NGEN Forcing (overriding Python package that comes with ngen base image)

# ## From GitHub
# RUN python -m pip install "git+${GITHUB_ORG_URL}/${REPO_NAME__NGEN_FORCING}@${REPO_TAG__NGEN_FORCING}"
# RUN python add_git_info.py --remote_repo_name "${REPO_NAME__NGEN_FORCING}" --remote_branch "${REPO_TAG__NGEN_FORCING}" --output_dir "/ngen-app/git-info"

# ## From local
# COPY "${REPO_NAME__NGEN_FORCING}/" "/tmp/${REPO_NAME__NGEN_FORCING}/"
# RUN python -m pip install "/tmp/${REPO_NAME__NGEN_FORCING}" && \
#     python add_git_info.py --local_repo_path "/tmp/${REPO_NAME__NGEN_FORCING}" --output_dir "/ngen-app/git-info" && \
#     rm -rf "/tmp/${REPO_NAME__NGEN_FORCING}/"



##################################################
############ BEGIN SECOND STAGE: Adding a separate Python venv for nwm.eval and nwm.verf

FROM ngen_rte_base AS ngen_rte_eval_verf

# Call modules like `python_eval_verf -m nwm.verf`
ARG EVAL_VERF_PYTHON_ALIAS="python_eval_verf"
ARG EVAL_VERF_VENV="/ngen-app/venvs/eval_verf"
ARG EVAL_VERF_PYTHON_BIN_DIR="${EVAL_VERF_VENV}/bin"
ARG EVAL_VERF_PYTHON_BIN_FILE="${EVAL_VERF_PYTHON_BIN_DIR}/python"

# Make the venv
RUN python -m venv "${EVAL_VERF_VENV}"
# Add an alias for convenience
RUN echo "alias ${EVAL_VERF_PYTHON_ALIAS}=\"${EVAL_VERF_PYTHON_BIN_FILE}\"" >> ~/.bashrc

# Save the current PATH and PYTHONPATH
ENV PATH_SAVED=${PATH}
ENV PYTHONPATH_SAVED=${PYTHONPATH}
# Adjust PATH and PYTHONPATH to give this environment precedent
ENV PATH="${EVAL_VERF_PYTHON_BIN_DIR}:${PATH}"
ENV PYTHONPATH="${EVAL_VERF_PYTHON_BIN_DIR}/lib/python3.11/site-packages"


##############################
#### Verification Manager (requires data-assimilation-engine)

## From GitHub
RUN ${EVAL_VERF_PYTHON_BIN_FILE} -m pip install "nwm.verf @ git+${GITHUB_ORG_URL}/${REPO_NAME__VERF_MGR}@${REPO_TAG__VERF_MGR}"
RUN python add_git_info.py --remote_repo_name "${REPO_NAME__VERF_MGR}" --remote_branch "${REPO_TAG__VERF_MGR}" --output_dir "/ngen-app/git-info"

# ## From local
# COPY "${REPO_NAME__VERF_MGR}/" "/tmp/${REPO_NAME__VERF_MGR}/"
# RUN ${EVAL_VERF_PYTHON_BIN_FILE} -m pip install "/tmp/${REPO_NAME__VERF_MGR}" && \
#     python add_git_info.py --local_repo_path "/tmp/${REPO_NAME__VERF_MGR}" --output_dir "/ngen-app/git-info" && \
#     rm -rf "/tmp/${REPO_NAME__VERF_MGR}/"


##############################
#### Evaluation Manager

## From GitHub
RUN ${EVAL_VERF_PYTHON_BIN_FILE} -m pip install "nwm.eval @ git+${GITHUB_ORG_URL}/${REPO_NAME__EVAL_MGR}@${REPO_TAG__EVAL_MGR}"
RUN python add_git_info.py --remote_repo_name "${REPO_NAME__EVAL_MGR}" --remote_branch "${REPO_TAG__EVAL_MGR}" --output_dir "/ngen-app/git-info"

## From Local
# COPY "${REPO_NAME__EVAL_MGR}/" "/tmp/${REPO_NAME__EVAL_MGR}/"
# RUN ${EVAL_VERF_PYTHON_BIN_FILE} -m pip install "/tmp/${REPO_NAME__EVAL_MGR}" && \
#     python add_git_info.py --local_repo_path "/tmp/${REPO_NAME__EVAL_MGR}" --output_dir "/ngen-app/git-info" && \
#     rm -rf "/tmp/${REPO_NAME__EVAL_MGR}/"


##############################
#### Clean up: reset PATH and PYTHONPATH
ENV PATH=${PATH_SAVED}
ENV PYTHONPATH=${PYTHONPATH_SAVED}

// Compound configuration for mpirun -n 2 was adapted from: https://gist.github.com/xangma/b2bc310e595f7abf61ff1e19f3fd63f5
// It starts individual debugpy instances to attach to each MPI rank after the C++ debugger (cppdbg) has started them with mpirun.
// 
// The python code must include this after MpiConfig communicator has initialized.
//   debugpy.listen(('localhost', 5678 + self.rank))
//   debugpy.wait_for_client()
// 
// Breakpoints in the python code can be set in the VS Code margins, and/or coded like: `debugpy.breakpoint()`
// 
{
    "version": "0.2.0",
    "compounds": [
        {
            "name": "run_bmi_model_mpi_n2",
            "configurations": [
                "_run_bmi_model_mpi_n2",
                "_python_attach_rank_0",
                "_python_attach_rank_1",
            ],
            "stopAll": true
        },
        // {
        //     "name": "run_ngen_mpi_n2",
        //     "configurations": [
        //         "_run_ngen_mpi_n2",
        //         "_python_attach_rank_0",
        //         "_python_attach_rank_1",
        //     ],
        //     "stopAll": true
        // },
        // {
        //     "name": "run_ngen_nompi",
        //     "configurations": [
        //         "_run_ngen_nompi",
        //         "_python_attach_rank_0",
        //     ],
        //     "stopAll": true
        // },
    ],
    "configurations": [
        {
            "name": "run_bmi_model_nompi",
            "type": "debugpy",
            "request": "launch",
            "module": "NextGen_Forcings_Engine_BMI.run_bmi_model",
            "args": [
                "2013-07-25 00:00:00",
                "2013-07-25 23:00:00",
                "-config_path",
                "/ngwpc/run_ngen/kge_dds/test_bmi/01123000/Input/forcing_config/aorc_config.yml",
                "-b_date",
                "201307250000",
                "-output_path",
                "/ngen-app/bin/bin_mounted/bmi_model_forcing_output_nompi.nc",
            ],
            "justMyCode": false,
            "console": "integratedTerminal",
            "python": "${command:python.interpreterPath}"
        },
        {
            "name": "run_bmi_model_test_regrid",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "cwd": "${workspaceFolder}/src/ngen-forcing",
            "env": {
                // "FORCING_PYTEST_WRITE_TEST_EXPECTED_DATA": "TRUE"
                "FORCING_PYTEST_WRITE_TEST_EXPECTED_DATA": "FALSE"
            },
            "justMyCode": false,
            "console": "integratedTerminal",
            "python": "${command:python.interpreterPath}"
        }
        ////////////////////
        // BEGIN _run_ngen_nompi 
        // {
        //     "name": "_run_ngen_nompi",
        //     "type": "cppdbg",
        //     "request": "launch",
        //     "program": "/ngwpc/run_ngen/kge_dds/test_bmi/01123000/Input/ngen",
        //     "cwd": "/ngwpc/run_ngen/kge_dds/test_bmi/01123000",
        //     "linux": {
        //         "MIMode": "gdb",
        //         "setupCommands": [
        //             {
        //                 "description": "Enable pretty-printing for gdb",
        //                 "text": "-enable-pretty-printing",
        //                 "ignoreFailures": true
        //             }
        //         ]
        //     },
        //     "args": [
        //         "/s3/ngwpc-hydrofabric/2.2/CONUS/01123000/GEOPACKAGE/USGS/2025_Mar_14_21_14_37/gauge_01123000.gpkg",
        //         "all",
        //         "/s3/ngwpc-hydrofabric/2.2/CONUS/01123000/GEOPACKAGE/USGS/2025_Mar_14_21_14_37/gauge_01123000.gpkg",
        //         "all",
        //         "01123000_realization_config_bmi_calib.json",
        //         "/ngwpc/run_ngen/kge_dds/test_bmi/01123000/Input/01123000_partition_config.json",
        //     ],
        // },
        // END _run_ngen_nompi 
        ////////////////////
        // BEGIN _run_bmi_model_mpi_n2 
        {
            "name": "_run_bmi_model_mpi_n2",
            "type": "cppdbg",
            "request": "launch",
            "program": "/usr/lib64/openmpi/bin/mpirun",
            "cwd": "${workspaceFolder}",
            "environment": [
                // { "name": "OMP_NUM_THREADS", "value": "2" },
                { "name": "WAIT_FOR_DEBUGPY", "value": "TRUE" },
            ],
            "linux": {
                "MIMode": "gdb",
                "setupCommands": [
                    {
                        "description": "Enable pretty-printing for gdb",
                        "text": "-enable-pretty-printing",
                        "ignoreFailures": true
                    }
                ]
            },
            "args": [
                "-n",
                "2",
                // "--bind-to",
                // "none",
                "python",
                "-um",
                "mpi4py",
                "-m",
                "NextGen_Forcings_Engine_BMI.run_bmi_model",
                "2013-07-25 00:00:00",
                "2013-07-25 23:00:00",
                "-config_path",
                "/ngwpc/run_ngen/kge_dds/test_bmi/01123000/Input/forcing_config/aorc_config.yml",
                "-b_date",
                "201307250000",
                "-output_path",
                "/ngen-app/bin/bin_mounted/bmi_model_forcing_output_mpi_n2.nc",
            ],
        },
        // END _run_bmi_model_mpi_n2
        ////////////////////
        // BEGIN _run_ngen_mpi_n2 
        // {
        //     "name": "_run_ngen_mpi_n2",
        //     "type": "cppdbg",
        //     "request": "launch",
        //     "program": "/usr/lib64/openmpi/bin/mpirun",
        //     "cwd": "/ngwpc/run_ngen/kge_dds/test_bmi/01123000",
        //     // "environment": [
        //     //     {
        //     //         "name": "OMP_NUM_THREADS",
        //     //         "value": "2"
        //     //     },
        //     // ],
        //     "linux": {
        //         "MIMode": "gdb",
        //         "setupCommands": [
        //             {
        //                 "description": "Enable pretty-printing for gdb",
        //                 "text": "-enable-pretty-printing",
        //                 "ignoreFailures": true
        //             }
        //         ]
        //     },
        //     "args": [
        //         "-n",
        //         "2",
        //         // "--bind-to",
        //         // "none",
        //         "/ngwpc/run_ngen/kge_dds/test_bmi/01123000/Input/ngen",
        //         "/s3/ngwpc-hydrofabric/2.2/CONUS/01123000/GEOPACKAGE/USGS/2025_Mar_14_21_14_37/gauge_01123000.gpkg",
        //         "all",
        //         "/s3/ngwpc-hydrofabric/2.2/CONUS/01123000/GEOPACKAGE/USGS/2025_Mar_14_21_14_37/gauge_01123000.gpkg",
        //         "all",
        //         "01123000_realization_config_bmi_calib.json",
        //         "/ngwpc/run_ngen/kge_dds/test_bmi/01123000/Input/01123000_partition_config.json",
        //     ],
        // },
        // END _run_ngen_mpi_n2 
        ////////////////////
        // BEGIN python attachers
        {
            "name": "_python_attach_rank_0",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "preLaunchTask": "sleep",
            "justMyCode": false
        },
        {
            "name": "_python_attach_rank_1",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5679
            },
            "preLaunchTask": "sleep",
            "justMyCode": false
        },
        // END python attachers
    ]
}